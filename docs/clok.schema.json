{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloK project documentation protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "docs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "title",
        "description"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "entry",
        "include"
      ],
      "properties": {
        "format": {
          "const": "mdx"
        },
        "entry": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.)(?!.*[\\\\:*?\"<>|\\x00-\\x1f])[^/]+(?:/[^/]+)*\\.mdx?$"
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.)(?!.*//)[\\w./*-]+\\.mdx?$"
          }
        }
      }
    }
  }
}
